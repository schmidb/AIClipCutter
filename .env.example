# ==============================================================================
# AIClipCutter — Environment Configuration Template
# Copy this file to `.env` and configure your settings:
#   cp .env.example .env
# ==============================================================================

# [REQUIRED] Google Cloud Project ID for Vertex AI (Gemini 3.8 Flash)
GCP_PROJECT_ID=your-gcp-project-id

# [REQUIRED] Path to Google Cloud Service Account JSON Key
# Grant Vertex AI User (roles/aiplatform.user) to this service account.
GOOGLE_APPLICATION_CREDENTIALS=config/gcp_service_account_key.json

# [OPTIONAL] Google Cloud Storage Bucket (if syncing final clips to cloud storage)
GCS_BUCKET_NAME=your-media-bucket-name

# [OPTIONAL] Gemini Model & Vertex AI Location
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

